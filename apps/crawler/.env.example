# Service role: bypasses RLS so the crawler can write catalog tables.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Identify the bot honestly and give the store a way to reach you.
CRAWLER_USER_AGENT=itaca-restock-bot/0.1 (+https://your-domain.example/bot; restock alerts)

# Politeness budget. 5s is itaca.gg's published Crawl-delay — do not lower it.
CRAWL_INTERVAL_SECONDS=5
CRAWL_DAILY_CAP=15000

WORKER_ID=worker-1
